[Unit]
Description=Selec MiBRX-6M Industrial IoT Edge Gateway & Dashboard
After=network.target network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=iotgateway
Group=iotgateway
WorkingDirectory=/opt/selec-iot-dashboard
EnvironmentFile=/opt/selec-iot-dashboard/.env
ExecStart=/opt/selec-iot-dashboard/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir /opt/selec-iot-dashboard/backend
Restart=always
RestartSec=5s

# Security Hardening & Sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

# Allow access to I2C/SPI devices for vibration sensor
SupplementaryGroups=i2c spi dialout

# Resource bounds
MemoryHigh=512M
MemoryMax=768M
CPUQuota=150%

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=selec-iot

[Install]
WantedBy=multi-user.target
