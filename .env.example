# ==============================================================================
# Environment Configuration Template for Selec PLC Dashboard
# Copy this file to .env and configure for your environment
# ==============================================================================

# Application Environment
ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PLC Modbus Connection
PLC_HOST=192.168.1.50
PLC_PORT=502
PLC_UNIT_ID=1
PLC_TIMEOUT_SECONDS=1.5
SIMULATION_MODE=false            # Default: physical Selec MiBRX-6M (set true for mock simulator)

# Safety & Remote Control
ALLOW_REMOTE_CONTROL=false        # SAFETY: Must be explicitly set to true to enable PLC control
CONTROL_TOKEN_SECRET=change-this-in-production-to-a-secure-random-key-64chars

# Vibration Sensor Settings (Direct Raspberry Pi 5 connection)
# Options: MOCK, I2C_ADXL345, I2C_MPU6050, SPI_ADXL355, ADC_ADS1115
VIBRATION_SENSOR_INTERFACE=MOCK
VIBRATION_SAMPLE_RATE_HZ=1000
VIBRATION_BUFFER_SIZE=512
VIBRATION_WARNING_RMS_G=1.8
VIBRATION_CRITICAL_RMS_G=3.5

# Database & Data Retention
DATABASE_URL=sqlite+aiosqlite:///./data/selec_iot.db
DATA_RETENTION_HOURS=720         # 30 days retention
MEASUREMENT_BUFFER_FLUSH_SEC=1.0 # Buffer aggregation flush interval to protect Pi 5 SD card

# Latency Benchmark Defaults
BENCHMARK_DURATION_SECONDS=60
BENCHMARK_TARGET_POLL_MS=200
